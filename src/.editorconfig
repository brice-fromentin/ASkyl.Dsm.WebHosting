# C# code style for Askyl.Dsm.WebHosting, enforced at build (EnforceCodeStyleInBuild) and by dotnet format.
#
# Options never carry a ":severity" suffix: several options feed one rule, and two suffixes on them would
# disagree about its severity. Each rule's severity is set once, as dotnet_diagnostic.<id>.severity.
# Nothing validates these keys: an unknown key or rule id is ignored without a word, which is how this file
# once enforced none of its rules. Make a new rule fire on a known violation before relying on it.
# IDE0005 and IDE0049 need XML documentation to run at build, which the projects do not generate: they fire
# in dotnet format instead, so the mandatory format step fixes them and the CI lint gate rejects them.

[*.cs]

# ============================================================================
# NAMING (IDE1006) — AGENTS.md §4: PascalCase members, camelCase parameters and locals
# ============================================================================

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.begins_with_i.capitalization = pascal_case
dotnet_naming_style.begins_with_i.required_prefix = I

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.members.applicable_kinds = property, method, event, local_function
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local

dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_begin_with_i.severity = warning

dotnet_naming_rule.types_are_pascal_case.symbols = types
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = warning

dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning

dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning

dotnet_naming_rule.members_are_pascal_case.symbols = members
dotnet_naming_rule.members_are_pascal_case.style = pascal_case
dotnet_naming_rule.members_are_pascal_case.severity = warning

dotnet_naming_rule.parameters_and_locals_are_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_are_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel_case.severity = warning

dotnet_diagnostic.IDE1006.severity = warning

# ============================================================================
# BRACES (IDE0011) — AGENTS.md §4: always braces on control flow
# ============================================================================

csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

# ============================================================================
# TYPE KEYWORDS (IDE0049, dotnet format only) — AGENTS.md §6.2: string for types, String. for static members
# ============================================================================

dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = false
dotnet_diagnostic.IDE0049.severity = warning

# ============================================================================
# COLLECTION EXPRESSIONS (IDE0028, IDE0300-IDE0305) — AGENTS.md §6.4
# ============================================================================

dotnet_style_prefer_collection_expression = true
dotnet_style_collection_initializer = true
dotnet_diagnostic.IDE0028.severity = error
dotnet_diagnostic.IDE0300.severity = error
dotnet_diagnostic.IDE0301.severity = error
dotnet_diagnostic.IDE0302.severity = error
dotnet_diagnostic.IDE0303.severity = error
dotnet_diagnostic.IDE0304.severity = error
dotnet_diagnostic.IDE0305.severity = error

# ============================================================================
# PRIMARY CONSTRUCTORS (IDE0290) — AGENTS.md §6.2: mandatory
# ============================================================================

csharp_style_prefer_primary_constructors = true
dotnet_diagnostic.IDE0290.severity = warning

# ============================================================================
# TARGET-TYPED NEW (IDE0090) — AGENTS.md §6.4: new() when the type is inferable
# ============================================================================

csharp_style_implicit_object_creation_when_type_is_apparent = true
dotnet_diagnostic.IDE0090.severity = warning

# ============================================================================
# USING DIRECTIVES (IDE0005, dotnet format only) — AGENTS.md §4: System first, alphabetical, unused removed
# ============================================================================

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

# ============================================================================
# OTHER CODE STYLE
# ============================================================================

# Add parentheses where precedence is not obvious
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity
dotnet_diagnostic.IDE0048.severity = warning

# Silent on a nullable parameter, by design: null is then a legal value
csharp_style_throw_expression = true
dotnet_diagnostic.IDE0016.severity = warning

dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0280.severity = warning

# Suggestions only: shown in the editor, never at build
csharp_prefer_simple_using_statement = true
dotnet_style_coalesce_expression = true
dotnet_style_null_propagation = true
dotnet_diagnostic.IDE0063.severity = suggestion
dotnet_diagnostic.IDE0029.severity = suggestion
dotnet_diagnostic.IDE0031.severity = suggestion

# ============================================================================
# .NET DESIGN GUIDELINES (CAxxxx)
# ============================================================================

dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1303.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1826.severity = warning
dotnet_diagnostic.CA1861.severity = suggestion

# ============================================================================
# DELIBERATELY NOT ENFORCED (measured on 2026-10-24)
# ============================================================================

# var (IDE0007, IDE0008): the code uses var everywhere but ten places, each an explicit type kept for clarity,
# which AGENTS.md §6.4 leaves to judgment.
# Accessibility modifiers (IDE0040): both conventions are in use, 163 and 254 declarations either way.
# Type parameter prefix: generic methods use single letters such as R and E.
