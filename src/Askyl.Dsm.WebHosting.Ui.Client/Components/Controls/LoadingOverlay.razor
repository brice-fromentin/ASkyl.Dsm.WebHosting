<FluentOverlay Visible="@WorkingState.IsWorking" Opacity="@Opacity">
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
        <FluentSpinner />
        @* SPIKE: Size400 approximates v4 Typography.Header (an h5); visual size unverified *@
        <FluentText As="TextTag.H5" Size="TextSize.Size400" Weight="TextWeight.Semibold" Class="full-size">
            @WorkingState.Message
        </FluentText>
    </FluentStack>
</FluentOverlay>

@code
{
    [Parameter, EditorRequired]
    public WorkingStateBase WorkingState { get; set; } = default!;

    [Parameter]
    public int Opacity { get; set; } = 40;
}
