@page "/"

@inherits WorkingStateBase

@using Askyl.Dsm.WebHosting.Ui.Client.Components.Patterns.WorkingState
@using Askyl.Dsm.WebHosting.Constants.Application
@using Askyl.Dsm.WebHosting.Constants.UI
@using Askyl.Dsm.WebHosting.Constants.WebApi
@using Askyl.Dsm.WebHosting.Data.Domain.WebSites
@using Askyl.Dsm.WebHosting.Data.Contracts
@using Askyl.Dsm.WebHosting.Globalization

@inject IDialogService DialogService
@inject IAuthenticationService AuthService
@inject IWebSiteHostingService WebsiteHostingService
@inject NavigationManager navigation
@inject INotificationService ToastService
@inject ILocalizer localizer
@inject ICultureManager CultureManager

<PageTitle>@localizer[LK.Home.PageTitle]</PageTitle>

<LoadingOverlay WorkingState="@this" />


    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Class="toolbar full-width">
    <FluentButton IconStart="@(new IconsRegular20.Add())" Appearance="ButtonAppearance.Default" OnClick="AddWebSite">
        @localizer[LK.Home.AddButton]
    </FluentButton>
    <FluentButton IconStart="@(new IconsRegular20.Edit())" Appearance="ButtonAppearance.Default" Disabled="@(SelectedInstance is null)" OnClick="EditWebSite">
        @localizer[LK.Home.EditButton]
    </FluentButton>
    <FluentButton IconStart="@(new IconsRegular20.Delete())" Appearance="ButtonAppearance.Default" Disabled="@(SelectedInstance is null)" OnClick="DeleteWebSite">
        @localizer[LK.Common.Delete]
    </FluentButton>
    <FluentDivider Vertical="true" />
    <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(SelectedInstance?.IsRunning == true)" OnClick="StartSelectedInstance" IconOnly="true" aria-label="@localizer[LK.Home.StartButton]">
        <FluentIcon Value="@(new IconsRegular20.Play())" Color="Color.Success" />
    </FluentButton>
    <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(SelectedInstance?.IsRunning != true)" OnClick="StopSelectedInstance" IconOnly="true" aria-label="@localizer[LK.Home.StopButton]">
        <FluentIcon Value="@(new IconsRegular20.Stop())" Color="Color.Error" />
    </FluentButton>
    <FluentSpacer />
    <FluentButton OnClick="ShowDotnetVersionsDialog" Appearance="ButtonAppearance.Outline">
        @localizer[LK.Home.DotnetVersionButton]
    </FluentButton>
    <FluentButton OnClick="ShowAspNetReleasesDialog" Appearance="ButtonAppearance.Outline">
        @localizer[LK.Home.AspNetOnlineButton]
    </FluentButton>
    <FluentButton OnClick="ShowLicensesDialog" Appearance="ButtonAppearance.Outline">
        @localizer[LK.Home.LicensesButton]
    </FluentButton>
    <FluentButton OnClick="DownloadLogs" Appearance="ButtonAppearance.Outline">
        @localizer[LK.Home.DownloadLogsButton]
    </FluentButton>
    <FluentDivider Vertical="true" />
    <FluentButton OnClick="Logout" Appearance="ButtonAppearance.Outline" IconStart="@(new IconsRegular20.SignOut())">
        @localizer[LK.Home.LogoutButton]
    </FluentButton>
</FluentStack>

<AutoDataGrid TItem="WebSiteInstance" Items="@GridInstances" OnReload="LoadInstancesAsync" OnRowClick="HandleInstanceSelected" OnRowDoubleClick="HandleInstanceDoubleClicked" GridTemplateColumns="1fr 2fr 1fr 1fr 1fr">
    <ChildContent>
        <PropertyColumn TGridItem="WebSiteInstance" TProp="string" ColumnId="@nameof(WebSiteConfiguration.Name)" Title="@localizer[LK.Home.GridColumnName]" Property="@(i => i.Configuration.Name)" Sortable="true" />
        <PropertyColumn TGridItem="WebSiteInstance" TProp="string" ColumnId="@nameof(WebSiteConfiguration.ApplicationPath)" Title="@localizer[LK.Home.GridColumnPath]" Property="@(i => i.Configuration.ApplicationPath)" Sortable="true" />
        <TemplateColumn TGridItem="WebSiteInstance" ColumnId="@nameof(WebSiteInstance.RequiredFramework)" Title="@localizer[LK.Home.GridColumnFramework]">
            @(GetFrameworkDisplay(context))
        </TemplateColumn>
        <PropertyColumn TGridItem="WebSiteInstance" TProp="int" ColumnId="@nameof(WebSiteConfiguration.InternalPort)" Title="@localizer[LK.Home.GridColumnInternalPort]" Property="@(i => i.Configuration.InternalPort)" Sortable="true" />
        <TemplateColumn TGridItem="WebSiteInstance" ColumnId="@nameof(WebSiteInstance.IsRunning)" Title="@localizer[LK.Home.GridColumnState]">
            @(context.IsRunning ? localizer[LK.Home.StateRunning] : localizer[LK.Home.StateStopped])
        </TemplateColumn>
    </ChildContent>
</AutoDataGrid>


@code
{
    private List<WebSiteInstance> Instances { get; set; } = [];

    private WebSiteInstance? SelectedInstance { get; set; }

    private IQueryable<WebSiteInstance> GridInstances => Instances.AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        await LoadInstancesAsync();
        await base.OnInitializedAsync();
    }

    private async Task LoadInstancesAsync()
    {
        using var worker = this.CreateWorkingState(localizer[LK.Home.LoadingWebsites]);

        try
        {
            var result = await WebsiteHostingService.GetAllWebsitesAsync();

            if (!result.Success || result.Value is null)
            {
                Instances = [];
                await ShowSafeErrorToast($"{localizer[LK.Error.FailedToLoadWebsites]}: {result.Message}");
                return;
            }

            Instances = result.Value;
        }
        catch (Exception ex)
        {
            Instances = [];
            await ShowSafeErrorToast($"{localizer[LK.Error.FailedToLoadWebsites]}: {ex.Message}");
        }
    }

    private async Task HandleInstanceDoubleClicked(WebSiteInstance instance)
    {
        SelectedInstance = instance;

        // OnRowDoubleClick is an EventCallback that AutoDataGrid already awaits, so returning the task
        // costs nothing and puts any failure back on the component instead of dropping it.
        await ShowWebSiteConfigurationDialogAsync(instance);
    }

    private async Task AddWebSite() => await ShowWebSiteConfigurationDialogAsync(new WebSiteInstance());

    private async Task EditWebSite() => await ShowWebSiteConfigurationDialogAsync(SelectedInstance);

    private void HandleInstanceSelected(WebSiteInstance instance) => SelectedInstance = instance;

    private string GetFrameworkDisplay(WebSiteInstance instance)
    {
        if (String.IsNullOrEmpty(instance.RequiredFramework))
        {
            return localizer[LK.Common.Dash];
        }

        return instance.RequiredFramework;
    }

    private async Task DeleteWebSite()
    {
        if (SelectedInstance is null)
        {
            return;
        }

        var selectedId = SelectedInstance.Id;
        var selectedName = SelectedInstance.Configuration.Name;

        // Show confirmation dialog
        var confirmationMessage = localizer[LK.Home.DeleteConfirmation, selectedName];
        var result = await DialogService.ShowConfirmationTextAsync(confirmationMessage, localizer[LK.Common.OK], localizer[LK.Common.Cancel]);

        if (result.Cancelled)
        {
            return;
        }

        using var worker = this.CreateWorkingState(localizer[LK.Loading.DeletingWebsite, selectedName]);

        try
        {
            var deleteResult = await WebsiteHostingService.RemoveWebsiteAsync(selectedId);

            if (!deleteResult.Success)
            {
                await ShowSafeErrorToast(deleteResult.Message ?? localizer[LK.Error.FailedToDeleteWebsite]);
                return;
            }

            Instances.RemoveAll(i => i.Id == selectedId);
            SelectedInstance = null;
        }
        catch (Exception ex)
        {
            await ShowSafeErrorToast(localizer[LK.Home.ErrorDeleting, ex.Message]);
        }
    }

    private async Task ShowWebSiteConfigurationDialogAsync(WebSiteInstance? instance)
    {
        if (instance is null)
        {
            return;
        }

        var options = CreateDialogOptions(DialogConstants.WidthMedium);
        options.Parameters[nameof(WebSiteConfigurationDialog.Content)] = instance;
        var result = await DialogService.ShowDialogAsync<WebSiteConfigurationDialog>(options);

        if (result.Cancelled)
        {
            return;
        }

        await LoadInstancesAsync();
    }

    private async Task StartSelectedInstance()
    {
        if (SelectedInstance is null)
        {
            return;
        }

        var selectedId = SelectedInstance.Id;
        var selectedName = SelectedInstance.Configuration.Name;

        using var worker = this.CreateWorkingState(localizer[LK.Loading.StartingWebsite, selectedName]);

        try
        {
            var result = await WebsiteHostingService.StartWebsiteAsync(selectedId);

            if (!result.Success)
            {
                await ShowSafeErrorToast(result.Message ?? localizer[LK.Error.FailedToStartWebsite]);
                return;
            }

            await LoadInstancesAsync();
        }
        catch (Exception ex)
        {
            await ShowSafeErrorToast(localizer[LK.Home.ErrorStarting, ex.Message]);
        }
    }

    private async Task StopSelectedInstance()
    {
        if (SelectedInstance is null)
        {
            return;
        }

        var selectedId = SelectedInstance.Id;
        var selectedName = SelectedInstance.Configuration.Name;

        using var worker = this.CreateWorkingState(localizer[LK.Loading.StoppingWebsite, selectedName]);

        try
        {
            var result = await WebsiteHostingService.StopWebsiteAsync(selectedId);

            if (!result.Success)
            {
                await ShowSafeErrorToast(result.Message ?? localizer[LK.Error.FailedToStopWebsite]);
                return;
            }

            await LoadInstancesAsync();
        }
        catch (Exception ex)
        {
            await ShowSafeErrorToast(localizer[LK.Home.ErrorStopping, ex.Message]);
        }
    }

    private async Task ShowDotnetVersionsDialog() => await ShowDialogAsync<DotnetVersionsDialog>(null);

    private async Task ShowAspNetReleasesDialog() => await ShowDialogAsync<AspNetReleasesDialog>(DialogConstants.WidthReleases);

    private async Task ShowLicensesDialog() => await ShowDialogAsync<LicensesDialog>(DialogConstants.WidthSmall);

    private void DownloadLogs()
    {
        // Navigate to log download endpoint defined in LogDownloadRoutes
        // Session cookie (DsmSid) is automatically sent with the request for authentication
        navigation.NavigateTo(LogDownloadRoutes.LogsFullRoute, forceLoad: true);
    }

    private async Task Logout()
    {
        try
        {
            var result = await AuthService.LogoutAsync();

            if (!result.Success)
            {
                await ShowSafeErrorToast(result.Message ?? localizer[LK.Error.FailedToLogout]);
                return;
            }

            CultureManager.ResetToSystem();
            navigation.NavigateTo(ApplicationConstants.LoginPagePath);
        }
        catch (Exception ex)
        {
            await ShowSafeErrorToast(localizer[LK.Home.ErrorLoggingOut, ex.Message]);
        }
    }

    #region Security Helpers

    /// <summary>
    /// Displays an error toast. Blazor automatically HTML-encodes rendered text,
    /// so no manual encoding is needed.
    /// </summary>
    private async Task ShowSafeErrorToast(string message)
    {
        // v5 toasts take a mandatory title; the message alone was all v4 showed
        await ToastService.ShowErrorToastAsync(message);
    }

    #endregion

    #region Dialog Helpers

    private async Task ShowDialogAsync<TComponent>(string? width) where TComponent : ComponentBase
        => await DialogService.ShowDialogAsync<TComponent>(CreateDialogOptions(width));

    // Modal = true renders type="alert", which ignores overlay clicks (v4 PreventDismissOnOverlayClick).
    // v4 TrapFocus = false and PreventScroll = true have no v5 option: the native dialog always traps focus.
    // No width keeps FluentUI 5's 600px: a width of "auto" filled the screen, the dialog being position: fixed
    private static DialogOptions CreateDialogOptions(string? width) => new()
    {
        Width = width,
        Modal = true,
        Header = { CloseAction = { Visible = true } }
    };

    #endregion

}