@using System.Collections.Immutable
@using Askyl.Dsm.WebHosting.Constants.Runtime
@using Askyl.Dsm.WebHosting.Data.Domain.Runtime
@using Askyl.Dsm.WebHosting.Data.Contracts
@using Askyl.Dsm.WebHosting.Globalization

@inject IDotnetVersionService DotnetVersionService
@inject INotificationService ToastService
@inject ILocalizer localizer

<FluentDialogBody>
    <TitleTemplate>
        <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold">@localizer[LK.DotnetVersions.DialogTitle]</FluentText>
    </TitleTemplate>
    <ChildContent>
        @if (IsLoading)
        {
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentSpinner />
                <FluentLabel>@localizer[LK.DotnetVersions.Searching]</FluentLabel>
            </FluentStack>
        }
        else if (DotnetVersions is { Count: > 0 })
        {
            <FluentCard>
                <FluentStack Orientation="Orientation.Vertical">
                    @foreach (var framework in DotnetVersions)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                            <FluentIcon Value="@GetFrameworkIcon(framework.Type)" />
                            <FluentText Weight="TextWeight.Bold">@framework.Type:</FluentText>
                            <FluentText>@framework.Version</FluentText>
                        </FluentStack>
                    }
                </FluentStack>
            </FluentCard>
        }
        else if (ErrorMessage != null)
        {
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new IconsRegular24.Warning())" Color="Color.Error" />
                <FluentText Color="Color.Error">
                    @ErrorMessage
                </FluentText>
            </FluentStack>
        }
        else
        {
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new IconsRegular24.Info())" Color="Color.Warning" />
                <FluentText>
                    @localizer[LK.DotnetVersions.NotFound]
                </FluentText>
            </FluentStack>
        }
    </ChildContent>
    <ActionTemplate>
        <FluentButton OnClick="CancelAsync" Appearance="ButtonAppearance.Primary">@localizer[LK.Common.Close]</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code
{
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    private bool IsLoading { get; set; } = false;
    private List<FrameworkInfo>? DotnetVersions { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnParametersSetAsync()
        => await LoadDotnetVersions();

    private async Task CancelAsync()
        => await Dialog.CancelAsync();

    private async Task LoadDotnetVersions()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var versionsResult = await DotnetVersionService.GetInstalledVersionsAsync();

            if (!versionsResult.Success)
            {
                ErrorMessage = versionsResult.Message ?? localizer[LK.DotnetVersions.FailedToLoad];
                DotnetVersions = [];
                return;
            }

            DotnetVersions = versionsResult.Value ?? [];
        }
        catch (Exception ex)
        {
            ErrorMessage = localizer[LK.DotnetVersions.ErrorSearching, ex.Message];
            DotnetVersions = [];
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Icon GetFrameworkIcon(string frameworkType)
    {
        return s_frameworkIcons.GetValueOrDefault(frameworkType, s_defaultIcon);
    }

    private static readonly ImmutableDictionary<string, Icon> s_frameworkIcons = new Dictionary<string, Icon>(StringComparer.Ordinal)
    {
        { DotNetFrameworkTypes.AspNetCore, new IconsRegular16.Globe() },
        { DotNetFrameworkTypes.Runtime, new IconsRegular16.Play() },
        { DotNetFrameworkTypes.Sdk, new IconsRegular16.Settings() },
        { DotNetFrameworkTypes.SdkMain, new IconsRegular16.Star() }
    }.ToImmutableDictionary();

    private static readonly Icon s_defaultIcon = new IconsRegular16.Code();
}
