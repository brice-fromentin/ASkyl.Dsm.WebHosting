@using Askyl.Dsm.WebHosting.Data.Domain.Runtime
@using Askyl.Dsm.WebHosting.Data.Contracts
@using Askyl.Dsm.WebHosting.Globalization

@inherits WorkingStateBase

@using Askyl.Dsm.WebHosting.Ui.Client.Components.Patterns.WorkingState
@inject IDialogService DialogService
@inject IDotnetVersionService DotnetVersionService
@inject IFrameworkManagementService ManagementService
@inject INotificationService ToastService
@inject ILocalizer localizer

<LoadingOverlay WorkingState="@this" />

<FluentDialogBody>
    <TitleTemplate>
        <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold">@localizer[LK.AspNetReleases.DialogTitle]</FluentText>
    </TitleTemplate>
    <ChildContent>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Class="toolbar full-width">
            <FluentLabel>@localizer[LK.AspNetReleases.ChannelLabel]</FluentLabel>

            @* No Width: it sizes only the field around the dropdown, which keeps its own 160px and overlapped the button *@
            <FluentSelect TOption="AspNetCoreReleaseInfo" TValue="AspNetCoreReleaseInfo" Items="@Channels" Value="@SelectedChannel" ValueChanged="OnChannelChanged" Disabled="@IsWorking" />

            <FluentButton OnClick="Refresh" Appearance="ButtonAppearance.Outline" IconOnly="true" Title="@localizer[LK.Common.Refresh]" Disabled="@IsWorking">
                <FluentIcon Value="@(new IconsRegular16.ArrowClockwise())" />
            </FluentButton>

            <FluentButton OnClick="@(IsSelectedVersionInstalled ? UninstallSelectedFramework : InstallSelectedFramework)" Appearance="ButtonAppearance.Primary" Disabled="@(!CanProcessSelected || IsWorking)" Class="flex-full-width">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                    <FluentIcon Value="@(IsSelectedVersionInstalled ? (Icon)new IconsRegular16.Delete() : new IconsRegular16.CloudArrowDown())" />
                    <FluentText>
                        @GetActionButtonText()
                    </FluentText>
                </FluentStack>
            </FluentButton>
        </FluentStack>

        <div class="dialog-grid-container">
            <AutoDataGrid TItem="AspNetRelease" Items="@Releases" GridTemplateColumns="1fr 120px 100px 120px" OnRowClick="@OnReleaseSelected" OnReload="@ReloadReleases">
                <ChildContent>
                    <PropertyColumn TGridItem="AspNetRelease" TProp="string" ColumnId="@nameof(AspNetRelease.Version)" Title="@localizer[LK.AspNetReleases.GridColumnVersion]" Property="@(r => r.Version)" Sortable="true" />
                    <TemplateColumn TGridItem="AspNetRelease" ColumnId="@nameof(AspNetRelease.IsInstalled)" Title="@localizer[LK.AspNetReleases.GridColumnInstalled]" Align="DataGridCellAlignment.Center">
                        @(context.IsInstalled ? localizer[LK.Common.CheckMark] : String.Empty)
                    </TemplateColumn>
                    <TemplateColumn TGridItem="AspNetRelease" ColumnId="@nameof(AspNetRelease.IsSecurity)" Title="@localizer[LK.AspNetReleases.GridColumnSecurity]" Align="DataGridCellAlignment.Center">
                        @(context.IsSecurity ? localizer[LK.Common.WarningIcon] : String.Empty)
                    </TemplateColumn>
                    <PropertyColumn TGridItem="AspNetRelease" TProp="DateTimeOffset?" ColumnId="@nameof(AspNetRelease.ReleaseDate)" Title="@localizer[LK.AspNetReleases.GridColumnRelease]" Property="@(r => r.ReleaseDate)" Format="d" Align="DataGridCellAlignment.End" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="DataGridSortDirection.Descending" />
                </ChildContent>
            </AutoDataGrid>
        </div>
    </ChildContent>
    <ActionTemplate>
        <FluentButton OnClick="CancelAsync" Appearance="ButtonAppearance.Primary" Disabled="@IsWorking" Class="flex-full-width">@localizer[LK.Common.Close]</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code
{
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    /// <summary>
    /// Gets or sets the product version of the channel to pre-select (e.g., "9.0").
    /// </summary>
    [Parameter]
    public string? Content { get; set; }

    private List<AspNetCoreReleaseInfo> Channels { get; set; } = [];

    private IQueryable<AspNetRelease> Releases { get; set; } = AutoDataGrid<AspNetRelease>.Empty();

    private AspNetCoreReleaseInfo? SelectedChannel { get; set; }

    private AspNetRelease? SelectedItem { get; set; }

    private bool _channelsLoaded;

    #region Computed Properties

    private bool IsSelectedVersionInstalled => SelectedItem?.IsInstalled == true;

    private bool CanProcessSelected => !IsWorking && SelectedItem != null;

    private bool CanInstallSelected => !IsWorking && SelectedItem != null && !SelectedItem.IsInstalled;

    private string GetActionButtonText()
    {
        if (SelectedItem == null)
        {
            return localizer[LK.AspNetReleases.SelectVersion];
        }

        return IsSelectedVersionInstalled
            ? localizer[LK.AspNetReleases.UninstallVersion, SelectedItem.Version]
            : localizer[LK.AspNetReleases.InstallVersion, SelectedItem.Version];
    }

    #endregion

    protected override async Task OnParametersSetAsync()
    {
        if (_channelsLoaded)
        {
            return;
        }

        _channelsLoaded = true;
        await LoadChannelsAsync();
    }

    private void OnReleaseSelected(AspNetRelease release)
    {
        SelectedItem = release;
        StateHasChanged();
    }

    private async Task OnChannelChanged(AspNetCoreReleaseInfo? channel)
    {
        SelectedChannel = channel;
        await LoadReleasesAsync(channel);
    }

    private async Task CancelAsync() => await Dialog.CancelAsync();

    private async Task LoadChannelsAsync()
    {
        try
        {
            using var worker = this.CreateWorkingState(localizer[LK.Loading.Channels]);

            var channelsResult = await DotnetVersionService.GetChannelsAsync();

            if (!channelsResult.Success)
            {
                await ShowErrorAsync(channelsResult.Message ?? localizer[LK.Error.FailedToLoadChannels]);
                Channels.Clear();
                SelectedChannel = null;
                return;
            }

            Channels = channelsResult.Value ?? [];

            var initialChannel = Channels.FirstOrDefault(c => c.ProductVersion == Content)
                ?? SelectedChannel
                ?? Channels.FirstOrDefault();

            await OnChannelChanged(initialChannel);
        }
        catch (Exception ex)
        {
            await ShowErrorAsync(ex.Message);
            Channels.Clear();
            SelectedChannel = null;
        }
    }

    private async Task LoadReleasesAsync(AspNetCoreReleaseInfo? channel)
    {
        SelectedItem = null;

        if (channel == null)
        {
            Releases = AutoDataGrid<AspNetRelease>.Empty();
            return;
        }

        try
        {
            using var worker = this.CreateWorkingState(localizer[LK.Loading.Releases]);

            var releasesResult = await DotnetVersionService.GetReleasesWithStatusAsync(channel.ProductVersion);

            if (!releasesResult.Success)
            {
                await ShowErrorAsync(releasesResult.Message ?? localizer[LK.Error.FailedToLoadReleases]);
                Releases = AutoDataGrid<AspNetRelease>.Empty();
                return;
            }

            var releases = releasesResult.Value ?? [];
            Releases = releases.AsQueryable();
        }
        catch (Exception ex)
        {
            await ShowErrorAsync(ex.Message);
            Releases = AutoDataGrid<AspNetRelease>.Empty();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Refresh() => await LoadChannelsAsync();

    private async Task ReloadReleases() => await LoadReleasesAsync(SelectedChannel);

    private async Task ShowErrorAsync(string error) => await DialogService.ShowErrorTextAsync(error);

    private async Task InstallSelectedFramework()
    {
        if (!CanInstallSelected || SelectedItem == null)
        {
            return;
        }

        try
        {
            using var worker = this.CreateWorkingState(localizer[LK.Loading.Installing]);

            var result = await ManagementService.InstallFrameworkAsync(SelectedItem.Version, SelectedChannel?.ProductVersion ?? String.Empty);

            if (result.Success)
            {
                await DialogService.ShowInfoTextAsync(result.Message ?? localizer[LK.Success.InstallationCompleted]);
                await Refresh();
            }
            else
            {
                await DialogService.ShowErrorTextAsync(result.Message ?? localizer[LK.Error.InstallationFailed]);
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowErrorTextAsync(localizer[LK.AspNetReleases.InstallationError, ex.Message]);
        }
    }

    private async Task UninstallSelectedFramework()
    {
        if (!IsSelectedVersionInstalled || SelectedItem == null)
        {
            return;
        }

        var confirmationMessage = localizer[LK.AspNetReleases.UninstallConfirmation, SelectedItem.Version];
        var result = await DialogService.ShowConfirmationTextAsync(confirmationMessage);

        if (result.Cancelled)
        {
            return;
        }

        try
        {
            using var worker = this.CreateWorkingState(localizer[LK.Loading.Uninstalling]);

            var uninstallResult = await ManagementService.UninstallFrameworkAsync(SelectedItem.Version);

            if (uninstallResult.Success)
            {
                await DialogService.ShowInfoTextAsync(uninstallResult.Message ?? localizer[LK.Success.UninstallationCompleted]);
                await Refresh();
            }
            else
            {
                await DialogService.ShowErrorTextAsync(uninstallResult.Message ?? localizer[LK.Error.UninstallationFailed]);
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowErrorTextAsync(localizer[LK.AspNetReleases.UninstallationError, ex.Message]);
        }
    }
}