@using Askyl.Dsm.WebHosting.Data.Domain.Licensing
@using Askyl.Dsm.WebHosting.Globalization

@inherits WorkingStateBase

@using Askyl.Dsm.WebHosting.Ui.Client.Components.Patterns.WorkingState
@inject ILicenseService LicenseService
@inject ILocalizer localizer

<LoadingOverlay WorkingState="@this" />

<FluentDialogBody>
    <TitleTemplate>
        <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold">@localizer[LK.Licenses.DialogTitle]</FluentText>
    </TitleTemplate>
    <ChildContent>
        @if (_licenses is not null)
        {
            <FluentTabs Orientation="Orientation.Vertical" Class="licenses-tabs">
                @foreach (var license in _licenses)
                {
                    <FluentTab Header="@license.Name">
                        <pre>@license.Content</pre>
                    </FluentTab>
                }
            </FluentTabs>
        }
        else
        {
            <FluentSpinner />
        }
    </ChildContent>
    <ActionTemplate>
        <FluentButton OnClick="CancelAsync" Appearance="ButtonAppearance.Primary" Class="flex-full-width">@localizer[LK.Common.Close]</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code
{
    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;

    private IReadOnlyList<LicenseInfo>? _licenses;

    protected override async Task OnInitializedAsync()
    {
        using var worker = this.CreateWorkingState(localizer[LK.Licenses.Loading]);

        _licenses = await LicenseService.GetLicensesAsync();
    }

    private async Task CancelAsync() => await Dialog.CancelAsync();
}