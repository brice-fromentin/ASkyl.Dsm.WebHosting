@inherits LayoutComponentBase

@using Askyl.Dsm.WebHosting.Globalization
@using Askyl.Dsm.WebHosting.Tools.Diagnostics

@inject ILocalizer localizer

<HeadContent>
    <link rel="stylesheet" href="@Assets["css/app.css"]" />

    <link rel="stylesheet" href="@Assets["css/components/dialogs/file-selection.css"]" />
    <link rel="stylesheet" href="@Assets["css/components/dialogs/aspnet-releases.css"]" />
    <link rel="stylesheet" href="@Assets["css/components/controls/auto-grid.css"]" />
</HeadContent>

<FluentLayout Class="full-size">
    <FluentLayoutItem Area="LayoutArea.Header" Class="app-header">
        @localizer[LK.Common.ApplicationTitle] @ApplicationVersion.Number
        @if (ApplicationVersion.Commit.Length > 0)
        {
            <sup><a class="build-commit" href="@ApplicationVersion.CommitUrl" target="_blank" rel="noopener noreferrer" title="@ApplicationVersion.Commit">@ApplicationVersion.ShortCommit</a></sup>
        }
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content">
        <div class="flex-column-container">
            @Body
        </div>
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Class="app-header">
        @localizer[LK.Common.UnhandledError]
        <FluentSpacer />
        <a href="." class="reload">
            <FluentIcon Value="@(new Icons.Regular.Size32.ArrowCounterclockwise().WithColor(Color.Error))" />
        </a>
        <span class="dismiss">
            <FluentIcon Value="@(new Icons.Regular.Size32.DismissCircle().WithColor(Color.Error))" />
        </span>
    </FluentStack>
</div>

@* The message bar and menu providers are gone: nothing here raises a message bar or a menu *@
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />