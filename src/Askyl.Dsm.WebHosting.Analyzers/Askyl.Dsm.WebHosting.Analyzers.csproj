<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);RS1038;RS1041;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Never above the compiler of the oldest SDK that builds this repository: SDK 10.0.302 ships Roslyn 5.6 and
         refuses an analyzer built against 5.9 with CS9057, a warning, so every ADWH rule silently stops applying.
         update-nuget.sh raises these to the latest; put them back. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.6.0" PrivateAssets="all" />
    <PackageReference Include="System.Composition" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

</Project>
